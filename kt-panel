  load();
});

async function load() {
  try {
    orders = (await api('/api/orders')).orders;
    render();
  } catch (e) {
    if (e.message !== 'unauthorized') toast(e.message);
  }
}

function fmtTime(t) {
  return new Date(t).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false, month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

const canDrag = () => filter === 'all' && orders.length > 1;

function grip() {
  const g = el('button', { class: 'grip', type: 'button', title: '拖动排序（键盘可用方向键）', 'aria-label': '拖动排序' });
  g.addEventListener('pointerdown', startDrag);
  g.addEventListener('keydown', nudge);
  return g;
}

const cardIds = () => [...document.querySelectorAll('#list .card')].map((c) => c.dataset.id);
let drag = null;
let saveChain = Promise.resolve();

function startDrag(e) {
  if (e.button !== 0) return;
  e.preventDefault();
  const card = e.currentTarget.closest('.card');
  const r = card.getBoundingClientRect();
  drag = { card: card, gx: e.clientX - r.left, gy: e.clientY - r.top, x: e.clientX, y: e.clientY, before: cardIds(), timer: setInterval(tick, 16) };
  card.classList.add('dragging');
  document.body.classList.add('dragging');
  window.addEventListener('pointermove', onMove);
  window.addEventListener('pointerup', endDrag);
  window.addEventListener('pointercancel', endDrag);
  place();
}

function onMove(e) {
  drag.x = e.clientX;
  drag.y = e.clientY;
  place();
}

// 先在原始布局里判断鼠标下面是哪张卡片并调整顺序，再让被拖的卡片跟着鼠标走
function place() {
  const card = drag.card;
  card.style.transform = 'none';
  const t = document.elementsFromPoint(drag.x, drag.y).find((n) => n !== card && n.classList.contains('card'));
  if (t && t.parentNode === card.parentNode) {
    const tr = t.getBoundingClientRect();
    if (drag.x < tr.left + tr.width / 2) t.before(card);
    else t.after(card);
  }
  const r = card.getBoundingClientRect();
  card.style.transform = 'translate(' + (drag.x - drag.gx - r.left) + 'px,' + (drag.y - drag.gy - r.top) + 'px)';
}

// 拖到屏幕上下边缘时自动滚动
function tick() {
  if (!drag) return;
  const dy = drag.y < 150 ? -14 : drag.y > window.innerHeight - 80 ? 14 : 0;
  if (dy) { window.scrollBy(0, dy); place(); }
}

function endDrag(e) {
  if (!drag) return;
  const card = drag.card;
  const before = drag.before;
  clearInterval(drag.timer);
  drag = null;
  window.removeEventListener('pointermove', onMove);
  window.removeEventListener('pointerup', endDrag);
  window.removeEventListener('pointercancel', endDrag);
  card.style.transform = '';
  card.classList.remove('dragging');
  document.body.classList.remove('dragging');
  if (e.type === 'pointercancel') { render(); return; }
  commitOrder(before);
}

function nudge(e) {
  const back = e.key === 'ArrowUp' || e.key === 'ArrowLeft';
  const fwd = e.key === 'ArrowDown' || e.key === 'ArrowRight';
  if (!back && !fwd) return;
  e.preventDefault();
  const g = e.currentTarget;
  const card = g.closest('.card');
  const before = cardIds();
  if (back && card.previousElementSibling) card.previousElementSibling.before(card);
  else if (fwd && card.nextElementSibling) card.nextElementSibling.after(card);
  else return;
  g.focus();
  commitOrder(before);
}

function commitOrder(before) {
  const now = cardIds();
  if (now.join() === before.join()) return;
  const map = new Map(orders.map((o) => [o.id, o]));
  orders = now.map((id) => map.get(id));
  saveChain = saveChain
    .then(() => api('/api/reorder', { method: 'POST', body: { ids: now } }))
    .then(() => toast('已保存顺序'))
    .catch((err) => { if (err.message !== 'unauthorized') toast(err.message); load(); });
}

async function sortByDate() {
  if (!confirm('按日期从早到晚重新排序？现在手动排好的顺序会被覆盖。')) return;
  try { await api('/api/sort-by-date', { method: 'POST', body: {} }); toast('已按日期排序'); await load(); }
  catch (e) { if (e.message !== 'unauthorized') toast(e.message); }
}

function card(o) {
  const cb = el('input', { type: 'checkbox' });
  cb.checked = !!o.send;
  cb.addEventListener('change', async () => {
    try {
      await api('/api/orders/' + o.id, { method: 'PUT', body: { send: cb.checked } });
      o.send = cb.checked;
      render();
    } catch (err) {
      cb.checked = !cb.checked;
      if (err.message !== 'unauthorized') toast(err.message);
    }
  });
  const sw = el('label', { class: 'sw' }, cb, el('i'), el('span', {}, o.send ? '推送' : '不推送'));

  const tags = el('div', { class: 'tags' },
    o.vendor ? el('span', { class: 'tag' }, o.vendor) : null,
    o.pending ? el('span', { class: 'tag warn' }, '待定') : null,
    o.date ? el('span', { class: 'date' }, o.date) : null);

  const rows = [['人员', o.engineer], ['通道', o.lanes], ['地址', o.address], ['备注', o.note]].filter((r) => r[1]);
  const dl = el('dl', {}, rows.map((r) => [el('dt', {}, r[0]), el('dd', {}, r[1])]));

  const foot = el('div', { class: 'foot' },
    el('small', {}, o.lastSentAt ? '上次推送 ' + fmtTime(o.lastSentAt) : '还没推送过'),
    el('button', { class: 'btn ghost', type: 'button', onclick: () => openForm(o) }, '编辑'),
    el('button', { class: 'btn ghost danger', type: 'button', onclick: () => remove(o) }, '删除'));

  return el('article', { class: 'card' + (o.send ? '' : ' off'), 'data-id': o.id }, el('div', { class: 'top' }, canDrag() ? grip() : null, el('h3', {}, o.name), sw), tags, dl, foot);
}

function render() {
  const on = orders.filter((o) => o.send).length;
  const seg = $('#seg');
  seg.replaceChildren();
  [['all', '全部', orders.length], ['on', '推送', on], ['off', '不推送', orders.length - on]].forEach((s) => {
    const b = el('button', { type: 'button', 'aria-pressed': String(filter === s[0]), onclick: () => { filter = s[0]; render(); } }, s[1], el('b', {}, s[2]));
    seg.append(b);
  });
  if (orders.length > 1) seg.append(el('button', { type: 'button', class: 'sortbtn', onclick: sortByDate }, '按日期排序'));

  const box = $('#list');
  box.replaceChildren();
  if (!orders.length) {
    box.append(el('div', { class: 'empty', style: 'grid-column:1/-1' },
      el('p', {}, '还没有工单'),
      el('button', { class: 'btn primary', onclick: () => openForm(null) }, '新增工单')));
    return;
  }
  const list = orders.filter((o) => filter === 'all' || (filter === 'on' ? o.send : !o.send));
  if (!list.length) {
    box.append(el('div', { class: 'empty', style: 'grid-column:1/-1' }, el('p', {}, '这个分类下没有工单')));
    return;
  }
  list.forEach((o) => box.append(card(o)));
}

function openForm(o) {
  editing = o ? o.id : null;
  $('#formTitle').textContent = o ? '编辑工单' : '新增工单';
  $('#f_name').value = o ? o.name : '';
  $('#f_date').value = o ? o.date || '' : '';
  $('#f_pending').checked = o ? !!o.pending : false;
  $('#f_vendor').value = o ? o.vendor || '' : '';
  $('#f_engineer').value = o ? o.engineer || '' : '';
  $('#f_lanes').value = o ? o.lanes || '' : '';
  $('#f_address').value = o ? o.address || '' : '';
  $('#f_note').value = o ? o.note || '' : '';
  $('#f_send').checked = o ? !!o.send : true;
  $('#formDlg').showModal();
}

$('#btnAdd').addEventListener('click', () => openForm(null));
$('#formCancel').addEventListener('click', () => $('#formDlg').close());
$('#form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const body = {
    name: $('#f_name').value,
    date: $('#f_date').value,
    pending: $('#f_pending').checked,
    vendor: $('#f_vendor').value,
    engineer: $('#f_engineer').value,
    lanes: $('#f_lanes').value,
    address: $('#f_address').value,
    note: $('#f_note').value,
    send: $('#f_send').checked,
  };
  try {
    if (editing) await api('/api/orders/' + editing, { method: 'PUT', body });
    else await api('/api/orders', { method: 'POST', body });
    $('#formDlg').close();
    toast('已保存');
    await load();
  } catch (err) {
    if (err.message !== 'unauthorized') toast(err.message);
  }
});

async function remove(o) {
  if (!confirm('删除「' + o.name + '」？删除后无法恢复。')) return;
  try { await api('/api/orders/' + o.id, { method: 'DELETE' }); toast('已删除'); await load(); }
  catch (e) { if (e.message !== 'unauthorized') toast(e.message); }
}

$('#btnSend').addEventListener('click', async () => {
  try {
    const d = await api('/api/preview', { method: 'POST', body: {} });
    if (!d.count) { toast('没有勾选推送的工单'); return; }
    $('#pvHead').textContent = '将发送 ' + d.count + ' 条工单，共 ' + d.messages.length + ' 条消息';
    const box = $('#pvBody');
    box.replaceChildren();
    d.messages.forEach((t) => box.append(el('pre', {}, t)));
    $('#pvDlg').showModal();
  } catch (e) {
    if (e.message !== 'unauthorized') toast(e.message);
  }
});
$('#pvCancel').addEventListener('click', () => $('#pvDlg').close());
$('#pvOk').addEventListener('click', async () => {
  const b = $('#pvOk');
  b.disabled = true;
  try {
    const d = await api('/api/send', { method: 'POST', body: {} });
    $('#pvDlg').close();
    toast('已发送 ' + d.sent + ' 条工单');
  } catch (e) {
    if (e.message !== 'unauthorized') toast(e.message);
  } finally {
    b.disabled = false;
    load();
  }
});

load();
</script>
</body>
</html>`;

