<script>
const $ = (s) => document.querySelector(s);
let orders = [];
let filter = 'all';

function el(tag, props, ...kids) {
  const e = document.createElement(tag);
  for (const k in props || {}) {
    if (k === 'class') e.className = props[k];
    else if (k.slice(0, 2) === 'on') e.addEventListener(k.slice(2), props[k]);
    else e.setAttribute(k, props[k]);
  }
  kids.flat(Infinity).forEach((c) => {
    if (c === null || c === undefined || c === false) return;
    e.append(c.nodeType ? c : document.createTextNode(String(c)));
  });
  return e;
}

function card(o) {
  const tags = el('div', { class: 'tags' },
    o.vendor ? el('span', { class: 'tag' }, o.vendor) : null,
    o.pending ? el('span', { class: 'tag warn' }, '待定') : null,
    o.date ? el('span', { class: 'date' }, o.date) : null);
  const rows = [['人员', o.engineer], ['通道', o.lanes], ['地址', o.address], ['备注', o.note]].filter((r) => r[1]);
  const dl = el('dl', {}, rows.map((r) => [el('dt', {}, r[0]), el('dd', {}, r[1])]));
  return el('article', { class: 'card pub' + (o.pending ? ' pending' : '') }, el('h3', {}, o.name), tags, dl);
}

function render() {
  const pend = orders.filter((o) => o.pending).length;
  const seg = $('#seg');
  seg.replaceChildren();
  [['all', '全部', orders.length], ['ok', '已确定', orders.length - pend], ['pending', '待定', pend]].forEach((s) => {
    seg.append(el('button', { type: 'button', 'aria-pressed': String(filter === s[0]), onclick: () => { filter = s[0]; render(); } }, s[1], el('b', {}, s[2])));
  });
  const box = $('#list');
  box.replaceChildren();
  const list = orders.filter((o) => filter === 'all' || (filter === 'pending' ? o.pending : !o.pending));
  if (!list.length) {
    box.append(el('div', { class: 'empty', style: 'grid-column:1/-1' }, el('p', {}, orders.length ? '这个分类下没有工单' : '暂无工单')));
    return;
  }
  list.forEach((o) => box.append(card(o)));
}

async function load() {
  try {
    const res = await fetch('/api/public');
    const d = await res.json();
    if (!res.ok) throw new Error(d.error || 'HTTP ' + res.status);
    orders = d.orders;
    render();
  } catch (e) {
    const box = $('#list');
    box.replaceChildren(el('div', { class: 'empty', style: 'grid-column:1/-1' }, el('p', {}, '加载失败：' + e.message), el('button', { class: 'btn', onclick: load }, '重试')));
  }
}
load();
</script>
</body>
