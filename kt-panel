/**
 * 工单推送 — Cloudflare Workers + KV + 企业微信群机器人
 *
 * 需要在 Cloudflare 控制台配置：
 *   KV 绑定   ORDER_KV        （变量名必须一致）
 *   密钥      WEBHOOK_URL     企业微信机器人完整 Webhook 地址
 *   密钥      ADMIN_PASSWORD  页面登录密码
 */



const LIMIT_BYTES = 3600; 

/* ---------------- 工具函数 ---------------- */

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' },
  });

async function sha(s) {
  const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
  return [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, '0')).join('');
}

async function authed(request, env) {
  const given = request.headers.get('x-auth') || '';
  return (await sha(given)) === (await sha(env.ADMIN_PASSWORD));
}

const page = (html) =>
  new Response(html, {
    headers: { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store', 'x-robots-tag': 'noindex' },
  });

const loadList = async (env) => (await env.ORDER_KV.get('orders', 'json')) || [];
const saveList = (env, list) => env.ORDER_KV.put('orders', JSON.stringify(list));

function sorted(list) {
  return [...list].sort((a, b) => {
    const da = a.date || '9999';
    const db = b.date || '9999';
    if (da !== db) return da < db ? -1 : 1;
    return (a.createdAt || 0) - (b.createdAt || 0);
  });
}

const TEXT_FIELDS = ['name', 'vendor', 'engineer', 'lanes', 'address', 'note', 'date'];

function clean(input, base) {
  const o = { ...base };
  for (const k of TEXT_FIELDS) {
    if (k in input) o[k] = String(input[k] ?? '').trim().slice(0, 300);
  }
  if ('pending' in input) o.pending = !!input.pending;
  if ('send' in input) o.send = !!input.send;
  return o;
}

function validate(o) {
  if (!o.name) return '项目名称必填';
  if (o.date && !/^\d{4}-\d{2}-\d{2}$/.test(o.date)) return '日期格式应为 YYYY-MM-DD';
  return null;
}

/* ---------------- 企业微信消息 ---------------- */

const today = () => new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
const byteLen = (s) => new TextEncoder().encode(s).length;

function block(o, i) {
  const lines = [];
  lines.push('**' + (i + 1) + '、' + o.name + '**' + (o.vendor ? '  <font color="info">' + o.vendor + '</font>' : ''));
  const d = [];
  if (o.pending) d.push('<font color="warning">待定</font>');
  if (o.date) d.push(o.date);
  if (d.length) lines.push('>日期：' + d.join(' '));
  if (o.engineer) lines.push('>人员：' + o.engineer);
  if (o.lanes) lines.push('>通道：' + o.lanes);
  if (o.address) lines.push('>地址：' + o.address);
  if (o.note) lines.push('>备注：' + o.note);
  return lines.join('\n');
}

// 按字节数拆成多条消息，每页记录包含的工单，便于发送成功后标记
function buildPages(items) {
  const pages = [];
  let cur = { items: [], blocks: [], bytes: 0 };
  items.forEach((o, i) => {
    const b = block(o, i);
    const size = byteLen(b) + 2;
    if (cur.items.length && cur.bytes + size > LIMIT_BYTES) {
      pages.push(cur);
      cur = { items: [], blocks: [], bytes: 0 };
    }
    cur.items.push(o);
    cur.blocks.push(b);
    cur.bytes += size;
  });
  if (cur.items.length) pages.push(cur);

  return pages.map((p, idx) => ({
    items: p.items,
    text:
      '## 📋 工单通知' + (pages.length > 1 ? '（' + (idx + 1) + '/' + pages.length + '）' : '') + '\n' +
      '<font color="comment">' + today() + '　共 ' + items.length + ' 条</font>\n\n' +
      p.blocks.join('\n\n'),
  }));
}

async function pushToWecom(env, content) {
  if (!env.WEBHOOK_URL) throw new Error('未配置环境变量 WEBHOOK_URL');
  const res = await fetch(env.WEBHOOK_URL, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ msgtype: 'markdown', markdown: { content } }),
  });
  const data = await res.json().catch(() => ({}));
  if (data.errcode !== 0) throw new Error('企业微信返回 ' + data.errcode + '：' + (data.errmsg || res.status));
}

/* ---------------- 路由 ---------------- */

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    if (!path.startsWith('/api/')) {
      if (path === '/') return page(PUBLIC_HTML);
      if (path === '/admin' || path === '/admin/') return page(ADMIN_HTML);
      return new Response('Not found', { status: 404 });
    }

    try {
      if (!env.ORDER_KV) return json({ error: '未绑定 KV，变量名需为 ORDER_KV' }, 500);

      // 公开只读接口：不需要密码
      if (path === '/api/public' && method === 'GET') {
        const list = (await loadList(env)).map(({ send, lastSentAt, createdAt, ...pub }) => pub);
        return json({ orders: list });
      }

      if (!env.ADMIN_PASSWORD) return json({ error: '未配置环境变量 ADMIN_PASSWORD' }, 500);
      if (!(await authed(request, env))) return json({ error: 'unauthorized' }, 401);

      const idMatch = path.match(/^\/api\/orders\/([\w-]+)$/);

      if (path === '/api/orders' && method === 'GET') {
        return json({ orders: await loadList(env) });
      }

      if (path === '/api/orders' && method === 'POST') {
        const body = await request.json();
        const o = clean(body, { id: crypto.randomUUID(), send: true, pending: false, createdAt: Date.now() });
        const err = validate(o);
        if (err) return json({ error: err }, 400);
        const list = await loadList(env);
        list.push(o);
        await saveList(env, list);
        return json({ order: o });
      }

      if (idMatch && method === 'PUT') {
        const list = await loadList(env);
        const idx = list.findIndex((x) => x.id === idMatch[1]);
        if (idx < 0) return json({ error: '工单不存在' }, 404);
        const o = clean(await request.json(), list[idx]);
        const err = validate(o);
        if (err) return json({ error: err }, 400);
        list[idx] = o;
        await saveList(env, list);
        return json({ order: o });
      }

      if (idMatch && method === 'DELETE') {
        const list = await loadList(env);
        await saveList(env, list.filter((x) => x.id !== idMatch[1]));
        return json({ ok: true });
      }

      if (path === '/api/reorder' && method === 'POST') {
        const { ids } = await request.json();
        if (!Array.isArray(ids)) return json({ error: 'ids 必须是数组' }, 400);
        const list = await loadList(env);
        const rest = new Map(list.map((o) => [o.id, o]));
        const next = [];
        for (const id of ids) {
          if (rest.has(id)) { next.push(rest.get(id)); rest.delete(id); }
        }
        for (const o of rest.values()) next.push(o); // 并发新增的工单排在最后
        await saveList(env, next);
        return json({ ok: true });
      }

      if (path === '/api/sort-by-date' && method === 'POST') {
        await saveList(env, sorted(await loadList(env)));
        return json({ ok: true });
      }

      if (path === '/api/preview' && method === 'POST') {
        const items = (await loadList(env)).filter((o) => o.send);
        return json({ count: items.length, messages: buildPages(items).map((p) => p.text) });
      }

      if (path === '/api/send' && method === 'POST') {
        const items = (await loadList(env)).filter((o) => o.send);
        if (!items.length) return json({ error: '没有勾选推送的工单' }, 400);
        const pages = buildPages(items);
        const sentIds = new Set();
        let failure = null;
        for (const p of pages) {
          try {
            await pushToWecom(env, p.text);
            p.items.forEach((o) => sentIds.add(o.id));
          } catch (e) {
            failure = e;
            break;
          }
        }
        if (sentIds.size) {
          const fresh = await loadList(env);
          const ts = Date.now();
          fresh.forEach((o) => { if (sentIds.has(o.id)) o.lastSentAt = ts; });
          await saveList(env, fresh);
        }
        if (failure) return json({ error: failure.message + '（已成功发送 ' + sentIds.size + ' 条）', sent: sentIds.size }, 502);
        return json({ sent: sentIds.size });
      }

      return json({ error: 'not found' }, 404);
    } catch (e) {
      return json({ error: e.message || String(e) }, 500);
    }
  },
};

